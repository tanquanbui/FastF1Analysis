# PitStop Analytics / FastF1Analysis local environment template
# Copy to .env for local-only overrides. Do not commit real secrets.

# AWS CLI profile/region for local deploy scripts.
AWS_PROFILE=pitstop-dev
AWS_REGION=ap-southeast-2
AWS_DEFAULT_REGION=ap-southeast-2

# Optional dashboard custom domain deployment parameters.
# CloudFront requires the certificate to be issued by ACM in us-east-1.
DASHBOARD_CUSTOM_DOMAIN=f1.quanbui.dev
DASHBOARD_CERTIFICATE_ARN=arn:aws:acm:us-east-1:123456789012:certificate/example

# GitHub Actions secret configured in the repo, not in this file:
# AWS_DEPLOY_ROLE_ARN=arn:aws:iam::123456789012:role/example
